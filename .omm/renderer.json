{
  "geometryTolerance": 0.75,
  "mermaid": {
    "theme": "base",
    "securityLevel": "strict",
    "deterministicIds": true,
    "htmlLabels": false,
    "fontFamily": "Open Sans, Noto Sans Math",
    "flowchart": {
      "htmlLabels": false,
      "curve": "basis",
      "nodeSpacing": 35,
      "rankSpacing": 45
    },
    "sequence": {
      "useMaxWidth": true,
      "actorFontFamily": "Open Sans, Noto Sans Math",
      "noteFontFamily": "Open Sans, Noto Sans Math",
      "messageFontFamily": "Open Sans, Noto Sans Math"
    },
    "themeVariables": {
      "fontFamily": "Open Sans, Noto Sans Math",
      "fontSize": "18px",
      "primaryColor": "#e7f4f3",
      "primaryTextColor": "#143d3b",
      "primaryBorderColor": "#186560",
      "lineColor": "#186560",
      "secondaryColor": "#fff4d6",
      "tertiaryColor": "#f0f4f8",
      "edgeLabelBackground": "#ffffff",
      "background": "#ffffff"
    }
  }
}
